# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交）。
# 用 Jenkins 部署时：把本文件填好后，整份粘进 Secret file 凭据「blog-env」（只需一次）。
# 不要用构建参数传口令——Jenkins 不会记住上次填的值。

# API 在宿主机上监听的端口（仅 127.0.0.1）。请选一个 VPS 上未被占用的端口。
BLOG_API_PORT=18086

# MySQL 口令。注意：只在数据卷【首次初始化】时生效，之后再改这里不会改变数据库里已有的口令。
BLOG_DB_ROOT_PASSWORD=change-me-root
BLOG_DB_PASSWORD=change-me-blog

# JWT 签名密钥，至少 32 个字符。生成： openssl rand -base64 48
BLOG_JWT_SECRET=change-me-at-least-32-characters-long-random

# 唯一的管理员账号。口令不存明文，只存 BCrypt 哈希。
BLOG_ADMIN_USERNAME=admin
# 哈希里含有 $ 符号，必须用【单引号】包住，否则 docker compose 会把它当成变量去展开。
# 生成（口令从标准输入读取，不会出现在命令行历史 / 进程列表里）：
#   read -rsp '口令: ' P; echo; printf '%s' "$P" | docker run --rm -i httpd:2.4-alpine htpasswd -niBC 10 x | cut -d: -f2; unset P
#   (read -s 隐藏输入，口令不会出现在屏幕和 shell 历史里)
BLOG_ADMIN_PASSWORD_HASH='$2y$10$replace-with-generated-hash'
